PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
TASKS_FILE=data/tasks.json
WEBHOOK_API_KEY=
MCP_API_KEY=
TASK_STORE_BACKEND=file
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_LIST_ID=
# Power Apps統合設定
# 環境変数のみに設定してください。Gitに秘密情報を記載しないこと。
POWERAPPS_TENANT_ID=
POWERAPPS_CLIENT_ID=
POWERAPPS_CLIENT_SECRET=
POWERAPPS_ENVIRONMENT_ID=
POWERAPPS_APP_ID=
POWERAPPS_LOG_PATH=data/powerapps-operations.jsonl
# Power Platform Git Integration / Dataverse
POWERAPPS_ORG_URL=
POWERAPPS_SOLUTION_UNIQUE_NAME=
# GitHub tokenはAzure App Settings等のSecretとして設定し、Gitへコミットしないこと。
POWERAPPS_GITHUB_TOKEN=
POWERAPPS_GITHUB_OWNER=oohiraplas-cpu
POWERAPPS_GITHUB_REPO=
POWERAPPS_GITHUB_BRANCH=main
POWERAPPS_GITHUB_ROOT=
# get_sharepoint_list（読み取り専用）はSHAREPOINT_*（上記）の認証情報を再利用する。
# SHAREPOINT_SITE_IDが既定サイト。get_sharepoint_list呼び出し時にsiteIdパラメータで上書き可能。
# Power Automate統合設定
# トリガーURL（HTTP要求受信時トリガー）はSAS署名を含む機密情報のため、
# Azure App Settings等のSecretとしてのみ設定し、Gitへコミットしないこと。
# JSON文字列で {"flowKey": "トリガーURL"} の形式で複数フローを登録できる。
POWER_AUTOMATE_FLOWS=
