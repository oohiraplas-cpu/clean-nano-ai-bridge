PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
TASKS_FILE=data/tasks.json
WEBHOOK_API_KEY=
MCP_API_KEY=
TASK_STORE_BACKEND=file
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_LIST_ID=
# CN_社員台帳（社員情報の書き込み: create_employee_ledger_entry / update_employee_ledger_entry）
# 対象リストのID。SHAREPOINT_SITE_ID配下のリストを指定する。認証情報はSHAREPOINT_*（上記）を再利用する。
SHAREPOINT_EMPLOYEE_LEDGER_LIST_ID=
# Power Apps統合設定
# 環境変数のみに設定してください。Gitに秘密情報を記載しないこと。
POWERAPPS_TENANT_ID=
POWERAPPS_CLIENT_ID=
POWERAPPS_CLIENT_SECRET=
POWERAPPS_ENVIRONMENT_ID=
POWERAPPS_APP_ID=
POWERAPPS_LOG_PATH=data/powerapps-operations.jsonl
# Power Platform Git Integration / Dataverse
POWERAPPS_ORG_URL=
POWERAPPS_SOLUTION_UNIQUE_NAME=
# GitHub tokenはAzure App Settings等のSecretとして設定し、Gitへコミットしないこと。
POWERAPPS_GITHUB_TOKEN=
POWERAPPS_GITHUB_OWNER=oohiraplas-cpu
POWERAPPS_GITHUB_REPO=
POWERAPPS_GITHUB_BRANCH=main
POWERAPPS_GITHUB_ROOT=
# Azure DevOps canonical Power Apps source. PAT is secret; configure only in Azure App Settings.
POWERAPPS_AZDO_ORGANIZATION=
POWERAPPS_AZDO_PROJECT=
POWERAPPS_AZDO_REPOSITORY=
POWERAPPS_AZDO_BRANCH=main
POWERAPPS_AZDO_ROOT=
POWERAPPS_AZDO_PAT=
# get_sharepoint_list（読み取り専用）はSHAREPOINT_*（上記）の認証情報を再利用する。
# SHAREPOINT_SITE_IDが既定サイト。get_sharepoint_list呼び出し時にsiteIdパラメータで上書き可能。
# Power Automate統合設定
# トリガーURL（HTTP要求受信時トリガー）はSAS署名を含む機密情報のため、
# Azure App Settings等のSecretとしてのみ設定し、Gitへコミットしないこと。
# JSON文字列で {"flowKey": "トリガーURL"} の形式で複数フローを登録できる。
POWER_AUTOMATE_FLOWS=
# デプロイ連携（deploy_to_test / verify_deployment / get_deployment_logs / rollback_deployment）
# 未設定の項目があるツールは、ダミー成功にせずstatus:not_configuredで拒否します。
# DEPLOY_GITHUB_TOKENはAzure App Settings等のSecretとしてのみ設定し、Gitへコミットしないこと。
# Power Appsソース用(POWERAPPS_GITHUB_TOKEN)とは別に、Actionsのworkflow実行・参照だけに絞った最小権限のトークンを使うこと。
DEPLOY_GITHUB_TOKEN=
DEPLOY_GITHUB_OWNER=oohiraplas-cpu
DEPLOY_GITHUB_REPO=clean-nano-ai-bridge
# デプロイ元として許可するbranch（カンマ区切り。未設定時はPOWERAPPS_GITHUB_BRANCH、既定main）
DEPLOY_ALLOWED_BRANCHES=main
# 非本番テスト環境（workflowはinputsとして environment, git_ref を受け取る契約）
DEPLOY_TEST_WORKFLOW=
DEPLOY_TEST_ENVIRONMENT_NAME=
DEPLOY_TEST_BASE_URL=
# 本番（rollback_deploymentでのみ使用。deploy_to_testは本番へ一切デプロイしない。approvedByHuman:true必須）
DEPLOY_PRODUCTION_WORKFLOW=
DEPLOY_PRODUCTION_ENVIRONMENT_NAME=
DEPLOY_PRODUCTION_BASE_URL=
DEPLOY_HISTORY_PATH=data/deployments.jsonl
DEPLOY_HEALTH_ATTEMPTS=3
DEPLOY_HEALTH_RETRY_DELAY_MS=5000
# 権限管理（get_permissions / update_permissions）
# 共有を許可するメールドメイン（カンマ区切り。メールアドレス指定の付与時に必須）
PERMISSIONS_ALLOWED_PRINCIPAL_DOMAINS=
# 付与を許可するDataverseセキュリティロール名（カンマ区切り。System Administrator等の強い権限は設定しても常に拒否）
PERMISSIONS_ALLOWED_DATAVERSE_ROLES=
