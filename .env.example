PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
TASKS_FILE=data/tasks.json
WEBHOOK_API_KEY=
MCP_API_KEY=
# claude.ai コネクタ用の読み取り専用エンドポイント(/connector/mcp)のキー。MCP_API_KEYとは別の値にする。空なら無効。
CONNECTOR_API_KEY=
# State Contextの期限（延長なし）と登録上限。再起動・別インスタンスでは再取得必須。
STATE_CONTEXT_TTL_MS=300000
STATE_CONTEXT_MAX_ENTRIES=1000
TASK_STORE_BACKEND=file
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_LIST_ID=
# CN_社員台帳（社員情報の書き込み: create_employee_ledger_entry / update_employee_ledger_entry）
# 対象リストのID。SHAREPOINT_SITE_ID配下のリストを指定する。認証情報はSHAREPOINT_*（上記）を再利用する。
SHAREPOINT_EMPLOYEE_LEDGER_LIST_ID=
# Power Apps統合設定
# 環境変数のみに設定してください。Gitに秘密情報を記載しないこと。
POWERAPPS_TENANT_ID=
POWERAPPS_CLIENT_ID=
POWERAPPS_CLIENT_SECRET=
POWERAPPS_ENVIRONMENT_ID=
POWERAPPS_APP_ID=
POWERAPPS_LOG_PATH=data/powerapps-operations.jsonl
# Power Platform Git Integration / Dataverse
POWERAPPS_ORG_URL=
POWERAPPS_SOLUTION_UNIQUE_NAME=
# GitHub tokenはAzure App Settings等のSecretとして設定し、Gitへコミットしないこと。
POWERAPPS_GITHUB_TOKEN=
POWERAPPS_GITHUB_OWNER=oohiraplas-cpu
POWERAPPS_GITHUB_REPO=
POWERAPPS_GITHUB_BRANCH=main
POWERAPPS_GITHUB_ROOT=
# Azure DevOps canonical Power Apps source. PAT is secret; configure only in Azure App Settings.
POWERAPPS_AZDO_ORGANIZATION=
POWERAPPS_AZDO_PROJECT=
POWERAPPS_AZDO_REPOSITORY=
POWERAPPS_AZDO_BRANCH=main
POWERAPPS_AZDO_ROOT=
POWERAPPS_AZDO_PAT=
# get_sharepoint_list（読み取り専用）はSHAREPOINT_*（上記）の認証情報を再利用する。
# SHAREPOINT_SITE_IDが既定サイト。get_sharepoint_list呼び出し時にsiteIdパラメータで上書き可能。
# Power Automate統合設定
# トリガーURL（HTTP要求受信時トリガー）はSAS署名を含む機密情報のため、
# Azure App Settings等のSecretとしてのみ設定し、Gitへコミットしないこと。
# JSON文字列で {"flowKey": "トリガーURL"} の形式で複数フローを登録できる。
POWER_AUTOMATE_FLOWS=
# デプロイ連携（deploy_to_test / verify_deployment / get_deployment_logs / rollback_deployment）
# 未設定の項目があるツールは、ダミー成功にせずstatus:not_configuredで拒否します。
# DEPLOY_GITHUB_TOKENはAzure App Settings等のSecretとしてのみ設定し、Gitへコミットしないこと。
# Power Appsソース用(POWERAPPS_GITHUB_TOKEN)とは別に、Actionsのworkflow実行・参照だけに絞った最小権限のトークンを使うこと。
DEPLOY_GITHUB_TOKEN=
DEPLOY_GITHUB_OWNER=oohiraplas-cpu
DEPLOY_GITHUB_REPO=clean-nano-ai-bridge
# デプロイ元として許可するbranch（カンマ区切り。未設定時はPOWERAPPS_GITHUB_BRANCH、既定main）
DEPLOY_ALLOWED_BRANCHES=main
# 非本番テスト環境（workflowはinputsとして environment, git_ref を受け取る契約）
DEPLOY_TEST_WORKFLOW=
DEPLOY_TEST_ENVIRONMENT_NAME=
DEPLOY_TEST_BASE_URL=
# 本番（rollback_deploymentでのみ使用。deploy_to_testは本番へ一切デプロイしない。approvedByHuman:true必須）
DEPLOY_PRODUCTION_WORKFLOW=
DEPLOY_PRODUCTION_ENVIRONMENT_NAME=
DEPLOY_PRODUCTION_BASE_URL=
DEPLOY_HISTORY_PATH=data/deployments.jsonl
DEPLOY_HEALTH_ATTEMPTS=3
DEPLOY_HEALTH_RETRY_DELAY_MS=5000
# 権限管理（get_permissions / update_permissions）
# 共有を許可するメールドメイン（カンマ区切り。メールアドレス指定の付与時に必須）
PERMISSIONS_ALLOWED_PRINCIPAL_DOMAINS=
# 付与を許可するDataverseセキュリティロール名（カンマ区切り。System Administrator等の強い権限は設定しても常に拒否）
PERMISSIONS_ALLOWED_DATAVERSE_ROLES=

# Read-only saved canvas source adapter. Disabled until PAC, Python, an existing
# authenticated PAC profile and an observed exact .msapp Src entry are available.
POWERAPPS_RUNTIME_SOURCE_ADAPTER=
# Enable only on a verified isolated host; these settings do not authenticate PAC.
# Only managedIdentity is accepted; blank keeps real reads blocked.
POWERAPPS_RUNTIME_AUTH_MODE=
# Optional observed user-assigned Managed Identity client ID.
POWERAPPS_RUNTIME_MI_CLIENT_ID=
# Required absolute path to a protected, dedicated, already authenticated PAC profile home.
POWERAPPS_RUNTIME_PAC_PROFILE_HOME=
POWERAPPS_RUNTIME_PYTHON=python3
POWERAPPS_RUNTIME_PAC=pac
# JSON mapping: canonical Git path -> exact observed Src/*.pa.yaml archive entry.
# Do not infer the archive entry from the Git filename.
POWERAPPS_RUNTIME_SOURCE_MAP={}

# entra_invite_user: 招待メールの承諾後に開くURL（https）。未設定なら https://myapplications.microsoft.com
# Graphアプリには User.Invite.All（アプリケーション権限・管理者の同意）が必要。テナント/クライアントは既存の SHAREPOINT_* / AZURE_* を使用。
ENTRA_INVITE_REDIRECT_URL=

# Google Workspace capability (Gemini/Gmail/Chat/Drive/Sheets/Docs/Calendar/GAS/CNKK) — reuse the existing Google OAuth of the same Workspace domain.
# Secrets go in deployment env only. Run `node scripts/google-consent-plan.js` once to see the exact scopes (one-time consent).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Required for mail/calendar recipients: addresses outside this domain need allowExternal + Human Gate. Unset => sends refused.
GOOGLE_WORKSPACE_DOMAIN=
# Comma-separated GAS functions that may run via gas.execute without Human Gate (read-only functions only)
GOOGLE_GAS_READONLY_FUNCTIONS=
# Gemini API generation stays OFF unless true (enable only after confirming it stays within the free tier)
GOOGLE_GEMINI_ENABLED=false
GOOGLE_GEMINI_MODEL=
# CNKK: Google Sheets (+GAS) by default. AppSheet API is optional (GOOGLE_CNKK_BACKEND=appsheet).
GOOGLE_CNKK_BACKEND=sheets
GOOGLE_CNKK_SPREADSHEET_ID=
GOOGLE_CNKK_GAS_SCRIPT_ID=
GOOGLE_APPSHEET_APP_ID=
GOOGLE_APPSHEET_ACCESS_KEY=
GOOGLE_CNKK_APPSHEET_TABLE=

# AppSheet CNKK Editor pipeline (no Enterprise/extra-contract API). The official API cannot edit app definitions; Editor changes use safe browser automation.
GOOGLE_APPSHEET_ALLOWED_APP_IDS=
GOOGLE_APPSHEET_ALLOWED_SCRIPT_IDS=
GOOGLE_APPSHEET_ASSET_DIR=
# Logged-in Playwright storageState files (human signs in once; files are secrets — keep out of git). Verifier uses its own browser context.
GOOGLE_APPSHEET_STORAGE_STATE=
GOOGLE_APPSHEET_VERIFIER_STORAGE_STATE=
# Absolute path to a JS module exporting Editor recipes recorded + verified against the real Editor (readDefinition/apply/save/deploy/readSharing/restore)
GOOGLE_APPSHEET_RECIPES=
