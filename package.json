{
  "name": "clean-nano-ai-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Bridge API for Power Platform and external AI services",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "validate:openapi": "node --test test/openapi.test.js",
    "test:mcp-tools": "node --test test/server.test.js test/deploymentService.test.js test/permissionsService.test.js test/powerAppsChangeValidation.test.js test/powerAppsStaticTests.test.js test/secretMasking.test.js",
    "test:safety": "node --test test/powerAppsGitStore.test.js",
    "test:inspection": "node --test test/powerAppsInspection.test.js",
    "check:secrets": "node scripts/check-secrets.js",
    "inspect:local": "node scripts/inspect-local-source.js",
    "validate:snapshot": "node scripts/validate-source-snapshot.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.0"
  }
}
